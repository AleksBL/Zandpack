def f(E): return 1/(1 + np.exp((E - mu)/kT))

def undiag(f,v):
    F = np.zeros(v.shape,dtype=complex)
    for i in range(f.shape[-1]):
        F[:, i,i] = f[:,i]
    return v @ F @ np.conj(v.transpose(0,2,1))

def h2dm(h):
    """ 
        DM = f(h) = v*f( eig(h) )*v^T (because of unitary eigenvectors)
    """
    e,v = np.linalg.eigh(h)
    dm  = undiag(f(e), v)
    return dm
