    if rank == 0:
        cur = np.zeros((hwN, amplN))
        err = np.zeros((hwN, amplN))
        for i in range(size):
            file = "_rank_"+str(i)+options["outfile"]
            if ".npz" not in file:
                file = file+".npz"
            f = np.load(file)
            cur += f["cur"]
            err += f["err"]
        np.savez_compressed(options["outfile"], cur=cur,err=err)
        for i in range(size):
            file = "_rank_"+str(i)+options["outfile"]
            if ".npz" not in file:
