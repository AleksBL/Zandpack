def fermi(e, mu, kT):
    return 1.0 / (1.0 + np.exp(np.clip((e - mu) / kT, -400.0, 400.0)))
def integrand(e, V, H0, sig_L, sig_R, hw,
              aL=0.0, aR=0.0, nflq=5, nphot=14, 
              eF=0.0, kT=5e-3, eta=0.5):
    """sum_{k,l} Tr[Gr Gam_R^(k) Ga Gam_L^(l)] (f_L^(l) - f_R^(k)) at energy e."""
    _use_fast = True # Toggle for the self energy calculation optimization.
    ms = np.arange(-nflq,  nflq +1)
    ls = np.arange(-nphot, nphot+1)
    nb, D = H0.shape[0], len(ms)

    muL, muR = eF + eta * V, eF - (1.0 - eta) * V
    uL, uR = muL - eF, muR - eF
    # --- retarded Green function ---
    if _use_fast==False:
        sigL = np.zeros((2 * nphot +1, nb, nb),dtype=complex)
        sigR = np.zeros((2 * nphot +1, nb, nb),dtype=complex)
    vL_v = np.zeros((len(ls), len(ms)))
    vR_v = np.zeros((len(ls), len(ms)))
    for il,l in enumerate(ls):
        vL  = np.array([jv(m + l, aL) for m in ms])
        vR  = np.array([jv(m + l, aR) for m in ms])
        vL_v[il], vR_v[il] = vL, vR
        if _use_fast==False:
            sigL[il], sigR[il] = sig_L(e-uL-l*hw), sig_R(e-uR-l*hw)
    if _use_fast:
        _Es_L= e - uL - ls * hw      # (L,), ordered by ls
        _Es_R= e - uR - ls * hw
        sigL = sig_L(_Es_L)          # (L, nb, nb), same ordering
        sigR = sig_R(_Es_R)
    
    sig =np.einsum("lm,ln,lij->minj",vL_v,vL_v,sigL,optimize=True)
    sig+=np.einsum("lm,ln,lij->minj",vR_v,vR_v,sigR,optimize=True)
    # Overwrite sigma with gamma
    for il,l in enumerate(ls):
        sigL[il] -= sigL[il].T.conj()
        sigL[il] *= 1j
        sigR[il] -= sigR[il].T.conj()
        sigR[il] *= 1j
    gr  = np.kron(np.diag(e + 0.0j + ms * hw), np.eye(nb))
    for i in range(D):
        gr[i*nb:(i+1)*nb, i*nb:(i+1)*nb] -= H0
    if Wmat is not None:
        _w = Wmat*((aL-aR)*hw*0.5)
        _wc = _w.T.conj()
        # Factor of 2 depends on the definition
        for i in range(0, D-1):
            b1 = slice( i*nb,    (i+1)*nb)
            b2 = slice((i+1)*nb, (i+2)*nb)
            gr[b1,b2] -= _w  
            gr[b2,b1] -= _wc
    gr -= sig.reshape(len(ms)*nb, len(ms)*nb)
    gr = np.linalg.inv(gr)
    ga = gr.T.conj()
    total = 0.0
    for ik, k in enumerate(ls):
        vR = np.array([jv(m + k, aR) for m in ms])
        gR = sigR[ik]
        fR = fermi(e - k * hw, muR, kT)
        W4 = np.einsum("minj,n,b,jl,blcv -> micv",
                       gr.reshape((nflq*2+1), nb, (nflq*2+1), nb),
                       vR, vR, gR,
                       ga.reshape((nflq*2+1), nb, (nflq*2+1), nb),
                       optimize=True)
        occ_v,occ_i = [],[]
        for ic, l in enumerate(ls):
            occ = fermi(e - l * hw, muL, kT) - fR
            if abs(occ) < 1e-14:
                continue
            occ_v.append(occ)
            occ_i.append(ic)
        if len(occ_v)<1:
            continue
        occ_v = np.array(occ_v); occ_i = np.array(occ_i)
        vL_ml = np.array([[jv(m + l, aL) for m in ms] for l in ls[occ_i]]).T.copy()
        total+= np.einsum("minj,nl,ml,l,lji->", W4, vL_ml, vL_ml, occ_v, sigL[occ_i], optimize=True).real
    return total
def current(V, **kw):
    val,err = quad(lambda e: integrand(e, V, **kw), 0.0, kw["hw"], 
                   epsabs=float(options["epsabs"]),
                   epsrel=float(options["epsrel"]),
                   limit=int(options["limit"]))
    val *= 1 / (hbar*2*np.pi)
    err *= 1 / (hbar*2*np.pi)
    return val,err

def calc_gfs(e, V, H0, sig_L, sig_R, hw,
             aL=0.0, aR=0.0, nflq=5, nphot=14, 
             eF=0.0, kT=5e-3, eta=0.5,
             ):
    """G^r, G^< and G^> at energy e.
       In steady-state, sig^< =   i f^<(e)gam(e)
       In steady-state, sig^> = - i f^>(e)gam(e)
       Convert Sigs to their floquet equivs: 
          Floquet A_{mn} = sum_l J_{m+l}(alpha)J_{n+l}(alpha) a(e - l hw)
       Here a is the steady state matrix, and A is the Floquet version. 
       G^< = G^r Sig^< G^a,
       G^> = G^r Sig^> G^a.
       G^{r/a} is already computed in the integrand function, so we 
       just need to compute Signa^</>.
       
       The NEGF identity X^> - X^< = X^r - X^a can be used to obtain some
       of the quantities from the other ones, since X^a = X^r^dagger
       is cheap to calculate. END CHOICE: Dont do this, but could be done.
    """
    ms = np.arange(-nflq,  nflq +1)
    ls = np.arange(-nphot, nphot+1)
    nb, D = H0.shape[0], len(ms)

    muL, muR = eF + eta * V, eF - (1.0 - eta) * V
    uL, uR = muL - eF, muR - eF
    # --- retarded Green function ---
    vL_v = np.zeros((len(ls), len(ms)))
    vR_v = np.zeros((len(ls), len(ms)))
    
    for il,l in enumerate(ls):
        vL  = np.array([jv(m + l, aL) for m in ms])
        vR  = np.array([jv(m + l, aR) for m in ms])
        vL_v[il], vR_v[il] = vL, vR
        # Moved outside loop, sig_L, sig_R now accepts array input for the energies.
        # sigL[il], sigR[il] = sig_L(e-uL-l*hw), sig_R(e-uR-l*hw)
    # This optimization should / could also be applied in the integrand function.
    # Fast way:
    _Es_L= e - uL - ls * hw      # (L,), ordered by ls
    _Es_R= e - uR - ls * hw
    sigL = sig_L(_Es_L)          # (L, nb, nb), same ordering
    sigR = sig_R(_Es_R)
    # assert np.allclose(sigL_fast, sigL), "comp failed"
    # assert np.allclose(sigR_fast, sigR), "comp failed"
    
    sig =np.einsum("lm,ln,lij->minj",vL_v,vL_v,sigL,optimize=True)
    sig+=np.einsum("lm,ln,lij->minj",vR_v,vR_v,sigR,optimize=True)
    # Overwrite sigma with gamma
    fR = np.zeros(len(ls))
    fL = np.zeros(len(ls))
    for il,l in enumerate(ls):
        # In this, we instead make the SigL/R hold the steady state 
        # lesser/greater self energies of the L/R. 
        sigL[il] -= sigL[il].T.conj()
        sigL[il] *= 1j
        sigR[il] -= sigR[il].T.conj()
        sigR[il] *= 1j
        # sigL and sigR contains now the levelwidth funcs of left and right
        fL[il] = fermi(e - l * hw, muL, kT)
        fR[il] = fermi(e - l * hw, muR, kT)
    # Construct Sig<,>
    path = np.einsum_path("lm,ln,l,lij->minj",vL_v,vL_v, fL,        sigL, optimize=True)[0]
    SigLL =     np.einsum("lm,ln,l,lij->minj",vL_v,vL_v, 1j* fL   , sigL, optimize=path)
    SigRL =     np.einsum("lm,ln,l,lij->minj",vR_v,vR_v, 1j* fR   , sigR, optimize=path)
    # G^> is calculated with the general relation instead
    SigLG =     np.einsum("lm,ln,l,lij->minj",vL_v,vL_v,-1j*(1-fL), sigL, optimize=path)
    SigRG =     np.einsum("lm,ln,l,lij->minj",vR_v,vR_v,-1j*(1-fR), sigR, optimize=path)
    SigG  = SigLG + SigRG
    SigL  = SigLL + SigRL
    _spectral_eta = 0.0 if options["spectral_eta"] == "None" else float(options["spectral_eta"])
    Gr    = np.kron(np.diag(e + _spectral_eta*1j  + ms * hw), np.eye(nb))
    for i in range(D):
        Gr[i*nb:(i+1)*nb, i*nb:(i+1)*nb] -= H0
    if Wmat is not None:
        _w = Wmat*((aL-aR)*hw*0.5)
        _wc = _w.T.conj()
        for i in range(0, D-1):
            b1 = slice( i*nb,    (i+1)*nb)
            b2 = slice((i+1)*nb, (i+2)*nb)
            Gr[b1,b2] -= _w
            Gr[b2,b1] -= _wc
    Gr -= sig.reshape(len(ms)*nb, len(ms)*nb)
    Gr  = np.linalg.inv(Gr)
    Ga  = Gr.T.conj()
    # Calculate <,> Gfs
    Gl = Gr @ SigL.reshape(len(ms)*nb, len(ms)*nb) @ Ga
    # Gg = Gr-Ga+Gl # fast way, exact when spectral_eta = 0
    Gg = Gr @ SigG.reshape(len(ms)*nb, len(ms)*nb) @ Ga
    
    # Test the general identity: (obviously only test without the shortcut for Gg)
    # Diff1 = Gr - Ga
    # Diff2 = Gg - Gl
    # if not np.allclose(Diff1, Diff2 ):
    #     print("G^> - G^< = G^r - G^a violation")
    #     print("maxabsdiff: ", str(np.abs(Diff1-Diff2).max()))
    return Gr, Gl, Gg
def calc_gr_only(e, V, H0, sig_L, sig_R, hw,
             aL=0.0, aR=0.0, nflq=5, nphot=14, 
             eF=0.0, kT=5e-3, eta=0.5,
             ):
    """G^r at energy e. 
       Convert Sigs to their floquet equivs: 
          Floquet A_{mn} = sum_l J_{m+l}(alpha)J_{n+l}(alpha) a(e - l hw)
       Here a is the steady state matrix, and A is the Floquet version. 
       G^< = G^r Sig^< G^a,
       G^> = G^r Sig^> G^a.
       G^{r/a} is already computed in the integrand function, so we 
       just need to compute Signa^</>.
       
       The NEGF identity X^> - X^< = X^r - X^a can be used to obtain some
       of the quantities from the other ones, since X^a = X^r^dagger
       is cheap to calculate. END CHOICE: Dont do this, but could be done.
    """
    ms = np.arange(-nflq,  nflq +1)
    ls = np.arange(-nphot, nphot+1)
    nb, D = H0.shape[0], len(ms)
    muL, muR = eF + eta * V, eF - (1.0 - eta) * V
    uL, uR = muL - eF, muR - eF
    vL_v = np.zeros((len(ls), len(ms)))
    vR_v = np.zeros((len(ls), len(ms)))
    for il,l in enumerate(ls):
        vL  = np.array([jv(m + l, aL) for m in ms])
        vR  = np.array([jv(m + l, aR) for m in ms])
        vL_v[il], vR_v[il] = vL, vR
    _Es_L= e - uL - ls * hw      # (L,), ordered by ls
    _Es_R= e - uR - ls * hw
    sigL = sig_L(_Es_L)          # (L, nb, nb), same ordering
    sigR = sig_R(_Es_R)
    sig =np.einsum("lm,ln,lij->minj",vL_v,vL_v,sigL,optimize=True)
    sig+=np.einsum("lm,ln,lij->minj",vR_v,vR_v,sigR,optimize=True)
    _spectral_eta = 0.0 if options["spectral_eta"] == "None" else float(options["spectral_eta"])
    Gr    = np.kron(np.diag(e + _spectral_eta*1j  + ms * hw), np.eye(nb))
    for i in range(D):
        Gr[i*nb:(i+1)*nb, i*nb:(i+1)*nb] -= H0
    if Wmat is not None:
        _w = Wmat*((aL-aR)*hw*0.5)
        _wc = _w.T.conj()
        for i in range(0, D-1):
            b1 = slice( i*nb,    (i+1)*nb)
            b2 = slice((i+1)*nb, (i+2)*nb)
            Gr[b1,b2] -= _w
            Gr[b2,b1] -= _wc
    Gr -= sig.reshape(len(ms)*nb, len(ms)*nb)
    return np.linalg.inv(Gr)
