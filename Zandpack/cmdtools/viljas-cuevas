    class dummy_se:
        def __init__(self, fitSE, kidx):
            self.SE   = fitSE
            self.kidx = kidx
            self.no   = fitSE.Coeffs.shape[-1]
            self.make_gamma()
        def self_energy(self, E, k = np.array([0.0, 0.0, 0.0])):
            res = (-1j/2) * self.gamma
            if isinstance(E, np.ndarray) and E.size > 1:
                return np.tile(res, (E.size, 1, 1))    # not broadcast_to: read-only
            return res
        def make_gamma(self):
            Emin, Emax, N = -5.0, 5.0, 252
            Eg = np.linspace(Emin, Emax,N)
            dE = Eg[1] - Eg[0]
            Eg = Eg[1:]*0.5 + Eg[:-1]*0.5
            G  = np.zeros((self.no, self.no),dtype=complex)
            for i in range(N-1):
                _Ei = np.array([Eg[i]])
                SE = self.SE.evaluate(_Ei, noopt=False)[self.kidx, 0]
                g  = 1j*(SE - SE.conj().T)
                G += g
            G*=(dE * float(options["Wideband_fact"]))
            G*=(1/(Emax-Emin))
            self.gamma = G

