if __name__ == "__main__" and options["mode"]== "current":
    _slurm_rank, _slurm_size = int(options["slurm_array_rank"]), int(options["slurm_array_size"])
    IJ = np.array([(i, j) for i in range(hwN) for j in range(amplN)])
    if _slurm_size > 1:
        # Further round-robin-like distribution between the outer ranks
        IJ = np.array_split(IJ, _slurm_size)[_slurm_rank]
    ntasks = len(IJ)
    # --- shared task counter on rank 0 -------------------------------------
    if rank == 0:
        counter = np.zeros(1, dtype=np.int64)
        win = MPI.Win.Create(counter, disp_unit=8, comm=comm)
    else:
        win = MPI.Win.Create(None, comm=comm)
    _one, _got = np.ones(1, dtype=np.int64), np.zeros(1, dtype=np.int64)
    def next_task():
        """Atomically claim the next index. Returns ntasks when exhausted."""
        win.Lock(0, MPI.LOCK_SHARED)
        win.Fetch_and_op(_one, _got, 0, 0, op=MPI.SUM)
        win.Unlock(0)
        return int(_got[0])
    # --- work loop ---------------------------------------------------------
    cur = np.zeros((hwN, amplN))
    err = np.zeros((hwN, amplN))
    ndone = 0
    while True:
        t = next_task()
        if t >= ntasks:
            break
        i, j = IJ[t]
        ajL = ampl[j]
        ajR = ampl[j]
        if options["nullify_L"] != "False":
            ajL = 0.0
        if options["nullify_R"] != "False":
            ajR = 0.0

        par = dict(H0=H0[kidx],
                   sig_L=lambda e: SE[0].self_energy(e),
                   sig_R=lambda e: SE[1].self_energy(e),
                   hw=hw[i], kT=float(options["kT"]),
                   aL = ajL / hw[i], aR = -ajR / hw[i],
                   nflq=int(options["NPHOT"]), nphot=int(options["NPHOT"]))
        cur[i, j], err[i, j] = current(float(options["voltage"]), **par)
        if np.isnan(cur).any():
            print("Found nan in result: ", np.where(np.isnan(cur)))
        ndone += 1
        print(f"rank {rank}, (srank {_slurm_rank}): local {ndone}, global {t+1}/{ntasks}", flush=True)
    win.Free()
    # --- collect: one call, no files, no sleep ------------------------------
    tot_cur = np.zeros_like(cur) if rank == 0 else None
    tot_err = np.zeros_like(err) if rank == 0 else None
    comm.Reduce(cur, tot_cur, op=MPI.SUM, root=0)
    comm.Reduce(err, tot_err, op=MPI.SUM, root=0)
    if rank == 0:
        if _slurm_size==1:
            np.savez_compressed(options["outfile"],
                                cur=tot_cur,
                                err=tot_err,
                                hw=hw,
                                ampl=ampl
                                )
        else:
            np.savez_compressed("slurm_"+str(_slurm_rank)+"-"+str(_slurm_size)+"_"+options["outfile"],
                                cur=tot_cur,
                                err=tot_err,
                                hw=hw,
                                ampl=ampl
                                )
if __name__ == "__main__" and options["mode"]== "spectral":
    # ================= spectral mode: DOS from G^r only =================
    # See Rudner & Lindner 2020 for a reference on the floquet formalism
    # (in addition to the Viljas & Cuevas paper)
    hw0     = float(hw[0])  # single photon energy per run, since grid needs to be split in pieces of hw/nE.
    _Egrid  = options["energies"].split(",")
    _E1, _E2, nE = [float(ei) for ei in _Egrid]
    nE      = int(nE)
    NPHOT   = int(options["NPHOT"])
    D       = 2*NPHOT + 1
    ms      = np.arange(-NPHOT, NPHOT+1)
    nb      = H0[kidx].shape[0]
    Nsub    = max(1, int(round(hw0*(nE - 1)/(_E2 - _E1))))   # grid pts per photon
    dE      = hw0/Nsub                                       # m*hw0 = m*Nsub*dE
    off     = NPHOT*Nsub                                     # padding in grid pts
    nE_win  = int(round((_E2 - _E1)/dE)) + 1
    nEext   = nE_win + 2*off
    _Egrid  = _E1 - off*dE + np.arange(nEext)*dE             # spans [E1-N*hw0, E2+N*hw0]

    _slurm_rank, _slurm_size = int(options["slurm_array_rank"]), int(options["slurm_array_size"])
    IJ = np.array([(j, iE) for j in range(amplN) for iE in range(nEext)])
    if _slurm_size > 1:
        IJ = np.array_split(IJ, _slurm_size)[_slurm_rank]
    ntasks = len(IJ)
    # --- shared task counter on rank 0 -------------------------------------
    if rank == 0:
        counter = np.zeros(1, dtype=np.int64)
        win = MPI.Win.Create(counter, disp_unit=8, comm=comm)
    else:
        win = MPI.Win.Create(None, comm=comm)
    _one, _got = np.ones(1, dtype=np.int64), np.zeros(1, dtype=np.int64)
    def next_task():
        """Atomically claim the next index. Returns ntasks when exhausted."""
        win.Lock(0, MPI.LOCK_SHARED)
        win.Fetch_and_op(_one, _got, 0, 0, op=MPI.SUM)
        win.Unlock(0)
        return int(_got[0])
    # --- work loop: one calc_gr_only per (ampl, E) --------------------------
    gr_pt = np.zeros((nEext, amplN, D), dtype=complex)
    ndone = 0
    while True:
        t = next_task()
        if t >= ntasks:
            break
        j, _iE = IJ[t]
        ajL, ajR = ampl[j], ampl[j]
        if options["nullify_L"] != "False":
            ajL = 0.0
        if options["nullify_R"] != "False":
            ajR = 0.0
        par = dict(H0=H0[kidx],
                   sig_L=lambda e: SE[0].self_energy(e),
                   sig_R=lambda e: SE[1].self_energy(e),
                   hw=hw0, kT=float(options["kT"]),
                   aL = ajL / hw0, aR = -ajR / hw0,
                   nflq=NPHOT, nphot=NPHOT)
        Gr = calc_gr_only(_Egrid[_iE], float(options["voltage"]), **par)
        for im, m in enumerate(ms):
            b = m + NPHOT
            gr_pt[_iE, j, im] = np.trace(Gr[b*nb:(b+1)*nb, b*nb:(b+1)*nb])
        if np.isnan(gr_pt[_iE, j]).any():
            print("Found nan in result")
        ndone += 1
        print(f"rank {rank}, (srank {_slurm_rank}): local {ndone}, global {t+1}/{ntasks}", flush=True)
    win.Free()
    # --- fold locally, then reduce the D-times-smaller folded array --------
    A_local = np.zeros((nEext, amplN), dtype=complex)
    for j in range(amplN):
        acc = np.zeros(nEext, dtype=complex)
        for im, m in enumerate(ms):
            s = m*Nsub                                   # exact integer shift
            lo, hi = max(0, s), min(nEext, nEext + s)
            acc[lo:hi] += gr_pt[lo-s:hi-s, j, im]
        A_local[:, j] = acc
    A_tot = np.zeros_like(A_local) if rank == 0 else None
    comm.Reduce(A_local, A_tot, op=MPI.SUM, root=0)
    # --- save --------------------------------------------------------------
    if rank == 0:
        dos = -(1/np.pi) * (A_tot/D).imag
        sl  = slice(off, off + nE_win)
        out = dict(dos=dos[sl], E=_Egrid[sl], hw=hw0, ampl=ampl)
        if _slurm_size == 1:
            np.savez_compressed(options["outfile"], **out)
        else:
            _folder = options["outfile"].replace(".npz", "")
            os.makedirs(_folder, exist_ok=True)
            _fname  = "slurm_"+str(_slurm_rank)+"-"+str(_slurm_size)+"_"+options["outfile"]
            np.savez_compressed(os.path.join(_folder, _fname), **out)