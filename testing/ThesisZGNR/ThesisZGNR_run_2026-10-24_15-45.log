Timedependent Bias:
@njit
def bias(t, a):
    """box_pulse(t, tp, ts, 1), inlined so it can be jitted."""
    box = (np.tanh(t / ts) - np.tanh((t - tp) / ts)) / 2
    return np.sign(a - .5) * (1 - box) * .5

